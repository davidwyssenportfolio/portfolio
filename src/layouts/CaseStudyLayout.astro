---
// Fixe Shell jeder Case Study:
// Nav 1 -> Hero (Overline · Title · Subtitle | Intro) -> erstes Bild -> Content-Slot -> Footer.
// Nav2 + Meta-Rail rendert die erste <Section first …> im Content.
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image, Picture } from 'astro:assets';
import { resolveImage, IMAGE_WIDTHS } from '../lib/images';
const { entry } = Astro.props;
const d = entry.data;
const hero = resolveImage(d.heroImage);
const heroSizes = '(min-width: 1312px) 1184px, (min-width: 768px) calc(100vw - 128px), calc(100vw - 48px)';
---
<BaseLayout title={`${d.title} — David Wyssen`} description={d.intro}>
  <div class="page">
    <div class="container">
      <Nav active="Arbeiten" />
      <header class="hero">
        <div class="hero-columns">
          <div class="title-block">
            {d.overline && <p class="text-overline">{d.overline}</p>}
            <h1 class="text-display">{d.title}</h1>
            {d.subtitle && <p class="text-subtitle">{d.subtitle}</p>}
          </div>
          <div class="intro-column">
            <p class="text-intro">{d.intro}</p>
          </div>
        </div>
        {hero ? (
          hero.format === 'svg' ? (
            <Image src={hero} alt={d.heroAlt} style="width:100%; height:auto" />
          ) : (
            <Picture src={hero} formats={['avif', 'webp']} widths={IMAGE_WIDTHS} sizes={heroSizes} alt={d.heroAlt} style="width:100%; height:auto" />
          )
        ) : null}
      </header>
      <main class="content">
        <slot />
      </main>
      {/* Layout-neutraler Marker (0 Höhe, kein Gap in .container): markiert das
          Seitenende für den Scrollspy (letzter Anker aktiv). */}
      <div id="nav2-end-sentinel" aria-hidden="true"></div>
    </div>
  </div>
  <Footer />
</BaseLayout>

<script>
  // Nav2-Verhalten (nur Case-Seiten). Statisch: läuft rein clientseitig.
  //  Teil 1 — Scrollspy: aktiver Anker wandert mit (IntersectionObserver, ⅓-Band),
  //           letzter Anker am Seitenende (Bottom-Sentinel).
  //  Teil 2 — Nav2 ausblenden, wenn ein VOLLBREITES Bild die Rail überdeckt.
  //           Auslöser über Blocktyp/Klasse (imageFull = .content > figure.image-card,
  //           imagePair = .content > .image-row-half); imageColumn (.image-row) NICHT.
  (() => {
    const nav = document.querySelector('.nav2');
    const content = document.querySelector('.content');
    if (!nav || !content) return; // Elemente fehlen -> no-op, kein Fehler

    const links = Array.from(nav.querySelectorAll('a.text-nav2'));
    if (!links.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Klick auf Anker: sanft scrollen, reduced-motion -> ohne Animation.
    for (const a of links) {
      a.addEventListener('click', (e) => {
        const href = a.getAttribute('href');
        if (!href || href.charAt(0) !== '#') return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'start' });
        history.replaceState(null, '', href);
      });
    }

    // ---- Teil 1: Scrollspy ----------------------------------------------
    // Anker -> Ziel-Section. Erstes Link-Element je Section gewinnt.
    const sections = [];
    const linkForSection = new Map();
    for (const a of links) {
      const href = a.getAttribute('href');
      const sec = href && href.charAt(0) === '#' ? document.querySelector(href) : null;
      if (sec && !linkForSection.has(sec)) { linkForSection.set(sec, a); sections.push(sec); }
    }

    let atEnd = false;
    let activeLink = null;
    const setActive = (link) => {
      if (!link || link === activeLink) return;
      for (const l of links) l.classList.remove('is-active');
      link.classList.add('is-active');
      activeLink = link;
    };
    setActive(links[0]); // Default: erster Anker

    // Dünnes Band auf ⅓ Fensterhöhe. Aktiv NUR bei Eintritt setzen
    // (beim Austritt nicht löschen) -> in Bild-Lücken bleibt die Markierung stehen.
    const spy = new IntersectionObserver((entries) => {
      if (atEnd) return;
      for (const entry of entries) {
        if (entry.isIntersecting) setActive(linkForSection.get(entry.target));
      }
    }, { rootMargin: '-33% 0px -66% 0px', threshold: 0 });
    for (const s of sections) spy.observe(s);

    // Seitenende: letzter Anker aktiv, überschreibt den Band-Scrollspy.
    const sentinel = document.getElementById('nav2-end-sentinel');
    if (sentinel) {
      new IntersectionObserver((entries) => {
        atEnd = entries[0].isIntersecting;
        if (atEnd) setActive(links[links.length - 1]);
      }, { threshold: 0 }).observe(sentinel);
    }

    // ---- Teil 2: Nav2 hinter vollbreiten Bildern ausblenden -------------
    // Auslöser rein über Klasse/Struktur (nicht Laufzeit-Breite):
    const coverers = Array.from(
      content.querySelectorAll(':scope > figure.image-card, :scope > .image-row-half'),
    );

    const covering = new Set();
    let coverObs = null;
    const applyHidden = () => nav.classList.toggle('nav2--hidden', covering.size > 0);

    const buildCoverObserver = () => {
      if (coverObs) coverObs.disconnect();
      covering.clear();
      if (!coverers.length) { applyHidden(); return; }
      // Band = vertikaler Bereich der sticky Nav2 (top .. top + Höhe).
      const top = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--spacing-024'), 10) || 24;
      const navH = nav.offsetHeight || 0;
      const bottom = Math.max(0, window.innerHeight - top - navH);
      coverObs = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) covering.add(entry.target);
          else covering.delete(entry.target);
        }
        applyHidden();
      }, { rootMargin: `-${top}px 0px -${bottom}px 0px`, threshold: 0 });
      for (const c of coverers) coverObs.observe(c);
    };
    buildCoverObserver();

    // Resize -> Band neu berechnen (kein Scroll-Listener). Unter 992 ist die Rail
    // per CSS ausgeblendet; die Klasse schadet dort nicht.
    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(buildCoverObserver, 150);
    });
  })();
</script>
