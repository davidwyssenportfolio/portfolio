---
// Fixe Shell jeder Case Study:
// Nav 1 -> Hero (Overline · Title · Subtitle | Intro) -> erstes Bild -> Content-Slot -> Footer.
// Nav2 + Meta-Rail rendert die erste <Section first …> im Content.
import BaseLayout from './BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { Image, Picture } from 'astro:assets';
import { resolveImage, IMAGE_WIDTHS } from '../lib/images';
const { entry } = Astro.props;
const d = entry.data;
const hero = resolveImage(d.heroImage);
const heroSizes = '(min-width: 1312px) 1184px, (min-width: 768px) calc(100vw - 128px), calc(100vw - 48px)';
---
<BaseLayout title={`${d.title} — David Wyssen`} description={d.intro}>
  <div class="page">
    <div class="container">
      <Nav active="Arbeiten" />
      <header class="hero">
        <div class="hero-columns">
          <div class="title-block">
            {d.overline && <p class="text-overline">{d.overline}</p>}
            <h1 class="text-display">{d.title}</h1>
            {d.subtitle && <p class="text-subtitle">{d.subtitle}</p>}
          </div>
          <div class="intro-column">
            <p class="text-intro">{d.intro}</p>
          </div>
        </div>
        {hero ? (
          hero.format === 'svg' ? (
            <Image src={hero} alt={d.heroAlt} style="width:100%; height:auto" />
          ) : (
            <Picture src={hero} formats={['avif', 'webp']} widths={IMAGE_WIDTHS} sizes={heroSizes} alt={d.heroAlt} style="width:100%; height:auto" />
          )
        ) : null}
      </header>
      <main class="content">
        <slot />
      </main>
      {/* Layout-neutraler Marker (0 Höhe, kein Gap in .container): markiert das
          Seitenende für den Scrollspy (letzter Anker aktiv). */}
      <div id="nav2-end-sentinel" aria-hidden="true"></div>
    </div>
  </div>
  <Footer />
</BaseLayout>

<script>
  // Nav2-Verhalten (nur Case-Seiten). Statisch: läuft rein clientseitig.
  //  Teil 1 — Scrollspy: aktiver Anker wandert mit (IntersectionObserver, ⅓-Band),
  //           letzter Anker am Seitenende (Bottom-Sentinel).
  //  Teil 2 — Nav2 ausblenden, wenn ein Bild die Nav-Spalte überdeckt. Auslöser rein
  //           GEOMETRISCH (kein Blocktyp/keine Klassenliste): horizontale Überlappung
  //           mit der sichtbaren Nav-Spalte (.nav2). Eingerückte Bilder (L=333 > 301)
  //           fallen automatisch raus, neue Bildtypen greifen automatisch.
  (() => {
    const nav = document.querySelector('.nav2');
    const content = document.querySelector('.content');
    if (!nav || !content) return; // Elemente fehlen -> no-op, kein Fehler

    const links = Array.from(nav.querySelectorAll('a.text-nav2'));
    if (!links.length) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

    // Sticky-Linie (muss zum CSS `top` der Nav passen, 64px) und Anker-Offset:
    // 64 Sticky + 32 Luft = 96px. Muss zu scroll-margin-top der Sections passen.
    const STICK = parseInt(getComputedStyle(document.documentElement).getPropertyValue('--spacing-064'), 10) || 64;
    const OFFSET = STICK + 32;

    // Scrub-Zonen der Cover-Blende (NUR vertikal — keine horizontale Toleranz, sonst
    // kollidiert die Nav-Spalte mit dem nur 32px entfernten eingerückten Bild).
    // opacity wird pro Frame direkt aus der Distanz Nav<->Bild gescrubbt, statt über
    // eine zeitbasierte CSS-Transition: Letztere hängt bei schnellem Scrollen hinterher
    // ("zu spät"), der Scrub ist per Konstruktion synchron (opacity=0 exakt bei Kontakt).
    // Asymmetrisch: über die HIDE-Zone (Anflug von unten) blendet sie aus, über die
    // kürzere SHOW-Zone (Abflug nach oben) wieder ein -> spätes, unaufdringliches Zurück.
    const NAV_HIDE_BUFFER = 128; // Anflug: Distanz, über die ausgeblendet wird
    const NAV_SHOW_BUFFER = 48;  // Abflug: Distanz, über die wieder eingeblendet wird

    // Scrollspy während eines Klick-Sprungs stummschalten, sonst springt die
    // Markierung auf eine durchquerte Section zurück.
    let suppressSpy = false;
    let suppressT;

    // Klick auf Anker: EXPLIZIT scrollen (kein scrollIntoView -> keine Safari-Quirks),
    // Section-Oberkante landet bei OFFSET (96px). reduced-motion -> ohne Animation.
    // Geklickter Anker wird sofort aktiv.
    for (const a of links) {
      a.addEventListener('click', (e) => {
        const href = a.getAttribute('href');
        if (!href || href.charAt(0) !== '#') return;
        const target = document.querySelector(href);
        if (!target) return;
        e.preventDefault();
        setActive(a);
        suppressSpy = true;
        clearTimeout(suppressT);
        suppressT = setTimeout(() => { suppressSpy = false; }, reduce.matches ? 60 : 700);
        const y = target.getBoundingClientRect().top + window.scrollY - OFFSET;
        window.scrollTo({ top: y, behavior: reduce.matches ? 'auto' : 'smooth' });
        history.replaceState(null, '', href);
      });
    }

    // ---- Teil 1: Scrollspy ----------------------------------------------
    // Anker -> Ziel-Section. Erstes Link-Element je Section gewinnt.
    const sections = [];
    const linkForSection = new Map();
    for (const a of links) {
      const href = a.getAttribute('href');
      const sec = href && href.charAt(0) === '#' ? document.querySelector(href) : null;
      if (sec && !linkForSection.has(sec)) { linkForSection.set(sec, a); sections.push(sec); }
    }

    let atEnd = false;
    let activeLink = null;
    const setActive = (link) => {
      if (!link || link === activeLink) return;
      for (const l of links) l.classList.remove('is-active');
      link.classList.add('is-active');
      activeLink = link;
    };
    setActive(links[0]); // Default: erster Anker
    // Direkte #section-URL: passenden Anker sofort aktiv.
    if (location.hash) {
      const l = links.find((a) => a.getAttribute('href') === location.hash);
      if (l) setActive(l);
    }

    // Aktiv-Auswahl robust: Set der Sections, die das ⅓... 64px-Band schneiden.
    // recompute() läuft bei JEDEM Callback (Spy + Sentinel) -> kein Race mit atEnd.
    // Leeres Set (Bild-Lücke zwischen Sections) -> vorherige Markierung behalten.
    const inBand = new Set();
    const recompute = () => {
      if (suppressSpy) return;
      if (atEnd) { setActive(links[links.length - 1]); return; }
      if (inBand.size === 0) return;
      let best = null, bestIdx = -1;
      for (const s of inBand) { const i = sections.indexOf(s); if (i > bestIdx) { bestIdx = i; best = s; } }
      if (best) setActive(linkForSection.get(best));
    };

    // Dünnes Band GENAU auf der Sticky-Linie (64px): ein Anker wird aktiv, sobald
    // die Oberkante seiner Section die 64px-Linie erreicht.
    let spy = null;
    const buildSpy = () => {
      if (spy) spy.disconnect();
      const bottom = Math.max(0, window.innerHeight - STICK - 2); // 2px-Band bei 64
      spy = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) inBand.add(entry.target);
          else inBand.delete(entry.target);
        }
        recompute();
      }, { rootMargin: `-${STICK}px 0px -${bottom}px 0px`, threshold: 0 });
      for (const s of sections) spy.observe(s);
    };
    buildSpy();

    // Seitenende: letzter Anker aktiv.
    const sentinel = document.getElementById('nav2-end-sentinel');
    if (sentinel) {
      new IntersectionObserver((entries) => {
        atEnd = entries[0].isIntersecting;
        recompute();
      }, { threshold: 0 }).observe(sentinel);
    }

    // ---- Teil 2: Nav2 ausblenden, wenn ein vollbreites Bild die Nav-Spalte überdeckt.
    // rAF-gedrosselte Scroll-Schleife, pro Frame SYNCHRON. opacity wird direkt aus der
    // Scroll-Geometrie GESCRUBBT (kein IntersectionObserver, keine zeitbasierte CSS-
    // Transition) -> per Konstruktion synchron mit der Scroll-Position, unabhängig von
    // der Geschwindigkeit (opacity=0 exakt, wenn das Bild die Nav erreicht). Referenz
    // ist die sichtbare sticky Nav (`.nav2`), NICHT die volle Rail; horizontal ohne
    // Toleranz. Eingerückte Bilder (beginnen rechts der Nav-Spalte) fallen automatisch
    // raus; neue Bildtypen funktionieren automatisch. KEIN Seitenende-Sonderfall:
    // überdeckt ein Bild am Ende die Nav, ist sie ausgeblendet — das ist der Zweck.
    const imageList = () => Array.from(content.querySelectorAll('img'));
    let coverImgs = imageList();
    const clamp01 = (x) => (x < 0 ? 0 : x > 1 ? 1 : x);
    let navPE = true; // aktueller pointer-events-Zustand (nur bei Wechsel schreiben)
    const updateCover = () => {
      const n = nav.getBoundingClientRect();
      // Horizontale Referenz: die sichtbare Nav-Spalte (.nav2, L..R), OHNE Toleranz.
      const colLeft = n.left, colRight = n.right;
      // Verdeckung h in [0..1] = max über alle die Spalte überlappenden Bilder.
      // Anflug (Bild unter der Nav): h scrubbt 0->1 über die HIDE-Zone.
      // Abflug (Bild über der Nav):  h scrubbt 1->0 über die kürzere SHOW-Zone.
      // Direkte Überlappung der Nav-Box: h=1. Übergänge an beiden Kanten stetig.
      let h = 0;
      for (const img of coverImgs) {
        const r = img.getBoundingClientRect();
        if (!r.width || !r.height) continue;
        if (!(r.left < colRight && r.right > colLeft)) continue; // nur Nav-Spalte
        let hi;
        if (r.top >= n.bottom) hi = 1 - (r.top - n.bottom) / NAV_HIDE_BUFFER;      // Anflug
        else if (r.bottom <= n.top) hi = 1 - (n.top - r.bottom) / NAV_SHOW_BUFFER; // Abflug
        else hi = 1;                                                              // deckt Nav
        hi = clamp01(hi);
        if (hi > h) h = hi;
        if (h >= 1) break;
      }
      // reduced-motion: harter Schnitt statt weichem Scrub.
      const opacity = reduce.matches ? (h >= 0.5 ? 0 : 1) : 1 - h;
      nav.style.opacity = String(opacity);
      // pointer-events erst kappen, wenn die Nav überwiegend weg ist (nur bei Wechsel).
      const pe = h < 0.5;
      if (pe !== navPE) { navPE = pe; nav.style.pointerEvents = pe ? '' : 'none'; }
    };
    let coverTick = false;
    const scheduleCover = () => { if (!coverTick) { coverTick = true; requestAnimationFrame(() => { coverTick = false; updateCover(); }); } };
    window.addEventListener('scroll', scheduleCover, { passive: true });
    updateCover();

    // Resize -> Scrollspy-Band neu, Bildliste + Cover neu.
    let rt;
    window.addEventListener('resize', () => {
      clearTimeout(rt);
      rt = setTimeout(() => { buildSpy(); coverImgs = imageList(); updateCover(); }, 150);
    });
    // Nach vollständigem Laden: Bildliste aktualisieren + Cover neu.
    window.addEventListener('load', () => { coverImgs = imageList(); updateCover(); });
  })();
</script>
