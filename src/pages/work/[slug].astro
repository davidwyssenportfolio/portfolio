---
// Case-Route. Datendateien statt MDX: die Seite baut komplett aus entry.data,
// deshalb entfällt render(entry). CaseRenderer setzt aus der Blockliste die
// bestehenden Komponenten zusammen (Section-Gruppierung inklusive).
import { getCollection } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import CaseRenderer from '../../components/CaseRenderer.astro';

export async function getStaticPaths() {
  const cases = await getCollection('cases', ({ data }) => !data.draft);
  return cases.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
---
<CaseStudyLayout entry={entry}>
  <CaseRenderer blocks={d.blocks} meta={d.meta} anchors={d.anchors} />
</CaseStudyLayout>
