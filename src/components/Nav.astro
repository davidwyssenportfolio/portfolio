---
import Logo from './Logo.astro';
const base = import.meta.env.BASE_URL;
const { active = '' } = Astro.props;
const links = [
  { label: 'Arbeiten', href: base },
  { label: 'Über', href: base + 'ueber' },
  { label: 'Kontakt', href: base + 'kontakt' },
];
---
<nav class="nav">
  <div class="nav-start"><Logo /></div>
  <div class="nav-end">
    <div class="nav-links">
      {links.map((l) => (
        <a class:list={['text-nav', { 'is-active': active === l.label }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <a class="nav-menu-toggle text-nav" href="#menu">Menü</a>
  </div>
</nav>
