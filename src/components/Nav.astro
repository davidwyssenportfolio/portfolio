---
import Logo from './Logo.astro';
import { url } from '../lib/url';
const { active = '' } = Astro.props;
const links = [
  { label: 'Arbeiten', href: url() },
  { label: 'Über', href: url('ueber') },
  { label: 'Kontakt', href: url('kontakt') },
];
---
<nav class="nav">
  <div class="nav-start"><Logo /></div>
  <div class="nav-end">
    <div class="nav-links">
      {links.map((l) => (
        <a class:list={['text-nav', { 'is-active': active === l.label }]} href={l.href}>{l.label}</a>
      ))}
    </div>
    <a class="nav-menu-toggle text-nav" href="#menu">Menü</a>
  </div>
</nav>
