---
// Bild + optionale Caption — gap 16. Breite definiert, Höhe frei.
import { url } from '../lib/url';
const { src, alt = '', caption } = Astro.props;
---
<figure class="image-card">
  <img src={url(src)} alt={alt} loading="lazy" />
  {caption && <figcaption class="text-caption">{caption}</figcaption>}
</figure>
